   xmp:MetadataDate="2022-03-09T10:50:03-05:00"
   aux:SerialNumber="S051001080320"
   xmpMM:DocumentID="adobe:docid:photoshop:fb7e6b5b-58aa-e449-b340-99e374cd992f"
   xmpMM:InstanceID="xmp.iid:622d97b5-1890-4bc9-b0e0-058436c10287"
   xmpMM:OriginalDocumentID="A45E9B51643D985F2186CB8575904945"
   tiff:ImageWidth="4000"
   tiff:ImageLength="3000"
   tiff:PhotometricInterpretation="2"
