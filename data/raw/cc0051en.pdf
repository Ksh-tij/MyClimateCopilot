<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 7.1-c000 79.83fae64, 2022/02/15-08:07:32        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
    xmlns:xmp="http://ns.adobe.com/xap/1.0/"
    xmlns:aux="http://ns.adobe.com/exif/1.0/aux/"
    xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
    xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#"
    xmlns:stRef="http://ns.adobe.com/xap/1.0/sType/ResourceRef#"
    xmlns:tiff="http://ns.adobe.com/tiff/1.0/"
    xmlns:exif="http://ns.adobe.com/exif/1.0/"
   dc:format="image/png"
   photoshop:LegacyIPTCDigest="D361C79E9A7FC8D83407288C73F4F48D"
   photoshop:CaptionWriter="Noisis Josette, was businesswoman in Port-au-Prince. After the earthquake of 12 January she lost everything and back to her village Bois Pin and join the Association of Women of Lascahobas, Bois Pin to benefit from Food Crops Intensification Project Phase II.&#xA;&#xA;The project focuses on an area where 95 per cent of the population depend on agriculture as their main source of livelihood and where one third of the population is involved in seasonal migration to the capital Port-au-Prince and the Dominican Republic. The overall goal of the project is to make sustainable improvements in rural poor people's incomes and welfare and foster their participation in development."
   photoshop:DateCreated="2010-07-29T18:28:41"
   photoshop:ColorMode="3"
   photoshop:ICCProfile="sRGB IEC61966-2.1"
   xmp:CreatorTool="Ver.1.0"
