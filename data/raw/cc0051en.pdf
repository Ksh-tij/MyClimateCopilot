     <rdf:li>irrigation,LAC,financial support</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Haiti - Food Crops Intensification Project - Phase II  - August 2010</rdf:li>
    </rdf:Alt>
   </dc:title>
