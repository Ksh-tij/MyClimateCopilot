05fd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;From the State of the World collection and other major reports to freshly penned technical studies, FAO publications cater to a diverse range of audiences. This catalogue presents a selection of FAO’s main publications, produced in 2025 or earlier, ranging from its global reports and general interest publications to numerous specialized titles. In addition to the major themes of agriculture, forestry and fisheries, it also includes thematic sections on climate, economic and social development, and food safety and nutrition.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;a1fba345-c4f9-4039-98df-53f7a4b6a11f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;104 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;7183a914-e721-462a-a5f0-6a99ba0262f1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140161-3&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;527d9c43-9485-477d-8179-66ee1a84ac6a&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd7085en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;c3fc72c2-e128-4177-8a8a-c287a8083868&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;8652ac8e-ba5e-49ed-9cbe-1198660d2f03&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;72057e72-922d-4a73-9130-60ff0cbab1fd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;1a8d2c26-ac58-452d-b089-1a708cc4700f&q;,&q;language&q;:null,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[