2-4424c6bb278f&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;9f532945-40c7-4e98-8d63-bf62a7d1ede8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;GAIN; 粮农组织; Cornell Univ., Ithaca;  Johns Hopkins University School of Advanced International Studies;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;fe0a1c05-c482-41c4-be42-e5c6174c248a&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-10T09:45:14Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;3b63502e-e3d8-4ed9-aa77-5df76328b55d&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-10T09:45:14Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;77534c9c-59f0-4f97-a867-76c7b3664a42&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;4aeb748c-4166-447a-b13c-23dfc179b382&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-10T09:40:10Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;342c350b-6683-4bf8-b2c6-a0ebfec116a4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;粮食体系通过提供食物、生计和生态系统服务，已成为人类生活不可或缺的一部分；它们在促进可持续发展方面具有尚未充分发挥的潜力。然而，目前它们也给人类健康、公平和环境可持续性带来了挑战。尽管目前正在改革粮食体系，以更好地支持这些多元目标，但仍需制定明确的评估指标，以摆脱俱全经验依据的局限，系统地追踪各国的进展情况。此处总结的“粮食体系倒计时”倡议的第三份报告正是为此而发布，该报告不仅补充了此前关于50项精心挑选的粮食体系指标趋势的数据，还基于一套全面的目标和基准，分析了当前进展是否足以实现各方商定的粮食体系转型目标。&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;f649ede2-0e2f-4add-a85f-5612f3af69b4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;3 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;7153b4b0-582b-4daf-b1a8-f0c1460b2533&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0482zh&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;: