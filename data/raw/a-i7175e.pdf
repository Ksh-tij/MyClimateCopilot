b098&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-06-26T08:47:34Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;04945261-5f3b-41e7-9d67-01b476bc84ac&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The Agricultural Outlook 2026–2035 is a collaborative effort of the Organisation for Economic Co-operation and Development (OECD) and the Food and Agriculture Organization of the United Nations (FAO). It brings together the commodity, policy, and country expertise of both organisations, as well as input from collaborating member countries, to provide an annual assessment of the prospects for the coming decade of national, regional, and global agricultural commodity markets.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;e2c9c5d3-928c-4802-9d9c-ec01e6bfcbb4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;166 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;67df3301-26df-4db4-950f-fd2dad431f08&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1999-1142&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;8ef86670-57db-4a08-987d-e1daca573eb6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140769-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;460f29fb-2658-4b9c-b3a1-83aae7120bfa&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1563-0447&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;7b15b40b-1df5-4355-b97a-962fba17011b&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0211en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;bd260038-5477-43d2-bdad-12bcaca247e1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;: