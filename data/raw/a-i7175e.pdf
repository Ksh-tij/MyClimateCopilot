89&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.initiator&q;:[{&q;uuid&q;:&q;b1d5188f-f6e7-4301-b368-15a27d1bc00b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Mostafapour, Ameneh (EST)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.leadauthoringunit&q;:[{&q;uuid&q;:&q;214f94e3-50da-478e-8af0-870cc5a9dc96&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;EST - Markets and Trade&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.placeofpublication&q;:[{&q;uuid&q;:&q;e5474b85-c2c3-499b-9983-68d1e3c40317&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Rome, Italy ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.previewpage&q;:[{&q;uuid&q;:&q;a2ccafa1-19d7-4f4e-bc5e-d9e72a2e6b74&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;p&g;&l;b&g;Markets at a Glance&l;/b&g;&l;/p&g;&l;ul&g;&l;li&g;&l;b&g;&l;i&g;Cereals&l;/i&g;&l;/b&g;&l;/li&g; This report provides an analysis of the most recent developments in the global cereals market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_cereals.pdf\&q; target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Wheat&l;/i&g;&l;/b&g;&l;/li&g; This report provides an analysis of the most recent developments in the global wheat market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_wheat.pdf\&q; target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Coarse Grains&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global coarse grains market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_grains.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Rice&l;/i&g;&l;/b&g;&l;/li&g; This report provides an analysis of the most recent developments in the global rice market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_rice.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Oilcrops, oils and meals&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global oilcrops market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_oilcrops.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Sugar&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global sugar market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_sugar.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Meat and meat products&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global meat market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_meat.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Milk and milk products&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global milk market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_milk.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Fish and other acquatic products&a;nbsp;&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global fish market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_fish.pdf\&q; target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;br&g;&l;/a&g;&l;/b&g;&l;/ul&g;&l;p&g;&l;/p&g;&l;p&g;&l;b&g;Special feature&l;/b&g;&l;/p&g;&l;p&g;&l;i&g;Using alternative fuels for international maritime shipping: implications for Small Island Developing States&l;/i&g;&l;/p&g;&l;p&g;Maritime shipping is accelerating trials of alternative fuels, driven by the International Maritime Organization’s (IMO) pathway to decarbonize the internationalmaritime sector. &l;b&g;&l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_special_feature1.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g;Read it here&l;/a&g;&l;/b&g;&l;/p&g;&l;p&g;&l;i&g;&l;br&g;Energy market uncertainty and ethanol–sugar price linkages&l;/i&g;&l;/p&g;&l;p&g;Energy markets, which are naturally volatile, have faced even greater uncertainty, driven by price swings, geopolitical risks, and an uneven energy transition. &l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_special_feature2.pdf\&q;&g;Read it here&l;/a&g;&l;/p&g;&l;p&g;&l;i&g;&l;br&g;Fertilizer market update&l;/i&g;&l;/p&g;&l;p&g;The Fertilizer Market Update reviews global fertilizer production, utilization, and trade in 2025, and then examines separately the disruptions and market developments that intensified in early 2026. &l;a href=\&q;https://www.fao.org/3/ce0204en/ce0204en_special_feature3.pdf\&q;&g;Read it here&l;/a&g;&l;/p&g;&l;p&g;&l;i&g;&l;br&g;&l;/i&g;&l;/p&g;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.sdgs&q;:[{&q;uuid&q;:&q;f89c8dc9-5dc7-4259-a025-f10e4f4e6c70&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;01. End poverty in all its forms everywhere&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.specialapprover.identifier&q;:[{&q;uuid&q;:&q;091e01a9-4bd9-498b-bc92-3ba903ae8892&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;17&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.subject.agrovoc&q;:[{&q;uuid&q;:&q;a64a9071-67d2-4a22-8fa7-178f49819070&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;commodity markets&q;,&q;place&q;:0,&q;authority&q;:&q;8718bc88da6d00da6e92a1e8a45adf3b27ceb552&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;4a3b59b4-8d2d-4ff3-adf9-a53168f91fdc&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;crop production&q;,&q;place&q;:1,&q;authority&q;:&q;f6b6cf227ca7413f28d8c5ec5c9e07d805acabc9&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;fd9dab42-fa42-466b-91a6-2258e7744c9b&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;crop forecasting&q;,&q;place&q;:2,&q;authority&q;:&q;7089b9496923574a7330690fbc4431abd9e887b7&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;4003e41b-8ab1-49d3-98e3-cec788c16a97&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;trade policies&q;,&q;place&q;:3,&q;authority&q;:&q;5d26b70276bf0777b63e1ddd20cbcfcb0c6b6495&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;bc54e027-93cb-43f4-94cf-6f16b062d1ab&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;agricultural prices&q;,&q;place&q;:4,&q;authority&q;:&q;d383062d6b3d8f1b8aec64c200188f1bf5e3adaa&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;e7da0e27-b100-42fb-9778-4ce718317d5e&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;food prices&q;,&q;place&q;:5,&q;authority&q;:&q;b9c8360cf14dd03a9ff82dc84fd639699567a93d&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;4cd8d57d-922c-4419-947d-ef989c6d4111&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;international trade policies&q;,&q;place&q;:6,&q;authority&q;:&q;26a97