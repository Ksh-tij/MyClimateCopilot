;:true,&q;isDiscoverable&q;:true,&q;isWithdrawn&q;:false,&q;_links&q;:{&q;bundles&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da&q;}},&q;_name&q;:&q;FAO and the SDGs&q;,&q;id&q;:&q;54f2a585-b703-4663-8537-5bfd287db4da&q;,&q;uuid&q;:&q;54f2a585-b703-4663-8537-5bfd287db4da&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;e3760c7f-6eaf-4c91-b086-91f5a176550b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;31c4e61a-46b3-4333-b9a7-7460b701ea1d&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-27T16:11:51Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;8f2cd1eb-d229-4c69-92cb-7284b7156cf3&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-27T16:11:51Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;b52d5d41-a5a7-4c81-9786-c0eda8a4c5e0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;03136a98-e8b8-4c51-a04b-b1bd3a126ef5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-05-27T16:02:49Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;bf358e0a-526f-4f94-941d-b1f59e674ed8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO and the SDGs – Accelerating transformation through the four betters provides a comprehensive overview of how transforming agrifood systems can drive progress across the entire 2030 Agenda for Sustainable Development. Drawing on FAO’s mandate and the Strategic Framework 2022–2031, the publication highlights the central role that sustainable, inclusive and resilient agrifood systems play in addressing global challenges such as hunger, poverty, inequality, climate change and environmental degradation.The publication brings together 17 concise briefs, one for each Sustainable Development Goal (SDG). Each brief outlines the relevance of agrifood systems to the Goal, presents key global trends and challenges, and highlights FAO’s areas of action and support to Members. It also identifies priority actions, innovations and partnerships needed to accelerate progress, offering practical entry points for governments and partners working to advance sustainable development.Together, the briefs show how progress on the SDGs is deeply interconnected with agrifood systems transformation. Framed through FAO’s four betters – better production, better nutrition, better environment and a better life – the publication presents an integrated roadmap for accelerating action across all 17 SDGs, while ensuring that agrifood systems contribute to a more sustainable, resilient and inclusive future.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;81a3a26d-f147-4187-9f2a-433bb484307b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;162 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;a817c7a3-a3b3-4ff0-86a5-74297099cfb3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140625-0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;0bd81093-3418-4cf7-926e-6013b6a93df7&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8857en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;9d13300a-a510-45b7-9f2e-05e803ca9fc7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;5afaabc6-1562-4db1-830a-97b98d9e5f68&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;d2f9315e-33a7-4c2a-9aed-b6c54ad01d35&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;508b81e7-c331-4f22-b86d-f83ce4882b86&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;1ead563c-af88-4465-8d93-be5e4afdf9e1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO and the SDGs&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;58606a66-ed3b-4fd0-97c9-abf49e87dce9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Accelerating transformation through the four betters&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;cbfac1a0-69ba-4f90-87dd-e378521908b9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (stand-alone)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}]