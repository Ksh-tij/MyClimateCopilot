{&q;uuid&q;:&q;a6ae0b67-9b13-46bc-accf-951a442bc6c3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;31250601-0184-4503-9feb-7815718b3e53&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-10T07:48:28Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;80a1dbc7-e7cb-4958-866a-5f8fc544307e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Les systèmes alimentaires font partie intégrante de la vie humaine à travers leur rôle dans l’approvisionnement alimentaire, les moyens de subsistance et les services écosystémiques ; ils recèlent un potentiel inexploité pour contribuer positivement au développement durable. Pourtant, ils posent actuellement des défis en matière de santé humaine, d’équité et de durabilité environnementale. Alors que des efforts sont en cours pour transformer les systèmes alimentaires afin qu’ils soutiennent davantage ces objectifs divers, des indicateurs bien définis sont nécessaires pour aller au-delà des anecdotes et suivre systématiquement les progrès réalisés dans les différents pays. Le troisième rapport de l’initiative Food Systems Countdown, résumé ici, répond à ce besoin en complétant les données antérieures sur les tendances de 50 indicateurs des systèmes alimentaires soigneusement sélectionnés par une analyse visant à déterminer si les progrès sont suffisants pour atteindre les objectifs convenus de transformation des systèmes alimentaires, sur la base d’un ensemble complet de cibles et de repères.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;ec7a7ff1-2502-42bc-9623-b7cb267447e9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;3 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;29d21228-1412-4a97-acee-14252377c661&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0482fr&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;de00324e-efbc-4950-8898-b53a5b137f44&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;French&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;e77b8618-c674-46e9-b9fd-5ee629839778&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;GAIN ; FAO ; Cornell University ; Johns Hopkins University ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;466aeaca-d111-403f-9e2d-db6ab03629b4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Shared&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;af97a55a-be32-4336-bdc5-582cac49e233&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;be978f83-aa7e-4b15-b9bf-3e3b6e898834&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Rapport sur le compte à rebours des systèmes alimentaires 2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.englishtranslation&q;:[{&q;uuid&q;:&q;7a2b31b8-4949-40f0-bb0c-448ee26378d0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The food systems countdown report 2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;3b339760-9c52-4b83-8ad0-fa5f527a94dd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Evaluer les performances, susciter le changement. Résumé&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitleenglishtranslation&q;:[{&q;uuid&q;:&q;aae56ab9-1a17-4dab-bfb6-c09a38c09139&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Assessing performance, driving change – Summary&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;92daecde-dbec-47c9-bec4-f54dfa55d459&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Brochure, flyer, fact-sheet&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altm