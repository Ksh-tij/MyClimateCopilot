229f0-fe93-48b3-9bfd-31f2dce75424&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;83f0b982-e643-4fc8-8ecc-f79bd39ad8d7&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-22T10:45:25Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;179fa7d8-1f1d-4c29-97a8-e1842aca3e98&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-22T10:45:25Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;485c5869-79a2-46d3-87f7-0c3b6c7ed7c5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;82b41c33-09ef-441e-9094-8f54bda5a69b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-06-22T10:41:48Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;5c390cd0-047d-4841-883d-08282ac597ff&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Guidance on the conduct of national censuses of agriculture has been provided to countries since 1930 through decennial programmes. This publication, World Programme for the Census of Agriculture 2030 (WCA 2030), is intended to provide guidance on agricultural censuses carried out by countries in the period between 2026 and 2035. The census of agriculture continues to play a key role in the collection of structural data on the agriculture sector. The WCA 2030 aims to provide countries with the tools and knowledge necessary to conduct comprehensive and accurate agricultural censuses, ensuring that the data collected is relevant, timely, internationally comparable and actionable.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;3de7c55c-a6bf-45ac-a578-42fb6aa196ff&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;232 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[