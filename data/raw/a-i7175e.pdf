://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36&q;}},&q;_name&q;:&q;The State of Food Security and Nutrition in the World 2026&q;,&q;id&q;:&q;63b052f9-f2c1-453b-97a3-1d814facea36&q;,&q;uuid&q;:&q;63b052f9-f2c1-453b-97a3-1d814facea36&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;fbf646ac-5ec4-45c0-887b-340e139fd473&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; IFAD; UNICEF; WFP; WHO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;5a680a38-0291-4df3-99fb-e6046ba9bacd&q;,&q;language&q;:null,&q;value&q;:&q;2026-07-24T12:00:56Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;ba2323f4-1914-4dd2-8ebc-c712ac635941&q;,&q;language&q;:null,&q;value&q;:&q;2026-07-24T12:00:56Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;7af02b73-2e6c-40b3-aea2-c2065b002a24&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;3755a637-7846-43fc-bec3-de83092a951a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-07-24T11:57:49Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;b5fb95ce-3463-4431-a2d1-ce5df9cb96da&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Despite sustained, gradual improvement in recent years, global hunger and food insecurity remain far above the targets set by the 2030 Agenda for Sustainable Development. It is estimated that 645 million people faced hunger in 2025.  Beyond ensuring access to sufficient dietary energy, populations must have economic access to safe, diverse and nutritious foods. Yet, healthy diets are unaffordable for about 2.7 billion people worldwide, with the crisis deepening particularly in Africa. The 2026 edition of The State of Food Security and Nutrition in the World evaluates this pressing challenge, exploring the structural drivers behind the persistently high cost of a healthy diet. This report reveals that the high prices of nutrient-dense items – specifically animal source foods, fruits and vegetables – account for nearly 70 percent of the cost of a healthy diet. By leveraging existing data and analytical tools, it examines how geographical disparities, agricultural productivity deficits, and value chain inefficiencies, including food loss and waste, create formidable barriers to accessing a healthy diet. To sustainably achieve Zero Hunger, policymakers must implement targeted, multisectoral interventions, from shifting agricultural subsidies towards horticulture, to investing in robust cold chains and transport networks. This report provides a comprehensive strategy for governments and stakeholders aiming to structurally lower diet costs and safeguard human capital, while avoiding the hidden costs of agrifood systems.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;b941b548-c789-433d-83a2-cc43dcd539e2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;249 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;eb6179a5-74bc-4696-b0f6-a7cc06a6eeaa&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-807X&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;46ff576c-1fc2-4901-99b5-83fe9223c08f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140461-4&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;52de5c25-09ed-45a4-8260-f67951375562&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8061&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;26f8902a-678e-44d6-9b71-9279ae9df59d&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8306en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;4e2f089a-27e8-40b5-971f-cbcac3caf09e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;119c0f22-d3e2-4b05-bdb9-df08861264cc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; IFAD ; UNICEF ; WFP ; WHO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;79362429-88e3-4753-a92c-5f8dcad9486b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The State of Food Security and Nutrition in the World (SOFI)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;15dcb9a6-4794-4991-8869-8027213611e8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;u