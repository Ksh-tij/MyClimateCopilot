c6332&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;63530481-33b1-42b8-9a4b-43dc6b804273&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; WMO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;9fc70478-5635-4c33-8699-3574e9b0e0d0&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-22T07:40:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;077f481e-6798-4abd-a295-9600dba73f0e&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-22T07:40:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;cdfe4161-4818-4a67-9e82-70ec0c0e6e4c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;e8b6def7-dc96-41a9-919f-ca971d23965e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-04-22T07:36:05Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;ad6f5506-984e-4ef8-9d4e-c162baa3d96d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Extreme heat is emerging as one of the most urgent and least understood threats to agriculture and food security. Rising temperatures, prolonged heatwaves, and shifting climate patterns are already disrupting crop yields, livestock health, water availability, and rural livelihoods – with impacts falling disproportionately on the most vulnerable.Because extreme heat is predictable, strengthening climate services and early warning systems linked to anticipatory actions is a key opportunity. It is also clear that there are profound limits to what adaptation can achieve. With global mean temperatures on the cusp of exceeding the 1.5 °C warming limit outlined in the Paris Agreement, the urgency for adaptation and mitigation action only grows. The only durable solution to protect the future of global agrifood systems from the escalating threat of extreme heat lies in ambitious, multilateral climate change mitigation.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;dba20aee-b147-4b71-a8aa-e59c7b47898d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;108 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;8f3596a0-d3ba-4480-a031-40e28a89684a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140656-4&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;12403907-8d1b-4a8e-af3b-95b84bc26b8f&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9394en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;1999505f-7c74-4b97-814d-0c66951f3ac0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;81a1102e-abf0-4e6c-8623-1bb00c363b9a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; WMO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;5c5a85cd-23c7-4a5b-afe9-6a3e5cf1e2fe&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Shared&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;69ffb4b0-8eac-4fb0-ba1b-65e7bb783056&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;5363f3bc-9b08-4888-a951-f0cf4552dc5c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Extreme heat and agriculture&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;6b79d51a-0ac4-454f-82a8-cf3315b6fb6a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO–WMO joint report&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;9e10623d-4dfd-4d97-a1e4-5b7ec70086aa&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (stand-alone)