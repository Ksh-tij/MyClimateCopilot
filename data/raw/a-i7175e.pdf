  <ds-selective-truncatable _ngcontent-sc866="" _nghost-sc864="" class="ng-star-inserted">
<div _ngcontent-sc864="" dsdragclick="">
    
    <a _ngcontent-sc866="" rel="noopener noreferrer" class="lead item-list-title dont-break-out text-primary ng-star-inserted" href="/items/63b052f9-f2c1-453b-97a3-1d814facea36" target="_self">The State of Food Security and Nutrition in the World 2026</a><!---->
    <!---->
    <h6 _ngcontent-sc866="" class="mt-1 ng-star-inserted">Understanding and addressing the high cost of a healthy diet</h6><!---->
    <span _ngcontent-sc866="" class="flex-group text-muted d-block mt-1">
      <span _ngcontent-sc866="" class="item-list-date py-1 ng-star-inserted">2026</span><!---->
      <ds-language-availability _ngcontent-sc866="" _nghost-sc865="" class="d-none"><ds-metadata-field-wrapper _ngcontent-sc865="" _nghost-sc219="" class="ng-star-inserted"><div _ngcontent-sc219="" class="simple-view-element">
  <h5 _ngcontent-sc219="" class="simple-view-element-header ng-star-inserted">Also available in:</h5><!---->
  <div _ngcontent-sc219="" class="simple-view-element-body">
    <ds-atmire-show-more _ngcontent-sc865="" _nghost-sc617="" class="ng-tns-c617-24 ng-star-inserted">
<div _ngcontent-sc617="" class="show-more ng-tns-c617-24 d-flex">
  <ds-atmire-object-collection _ngcontent-sc617="" class="ng-tns-c617-24 ng-tns-c616-25 ng-star-inserted" _nghost-sc616="">
<!---->
<div _ngcontent-sc616="" class="aoc ng-tns-c616-25 ng-star-inserted">
  <!---->
  <!---->
  <span _ngcontent-sc616="" class="aoc-no-results ng-tns-c616-25 ng-star-inserted" style="">No results found.</span><!---->
