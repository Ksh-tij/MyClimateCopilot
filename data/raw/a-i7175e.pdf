/core/items/a764cdc9-6bea-4600-a075-88a53c3d04aa/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/a764cdc9-6bea-4600-a075-88a53c3d04aa/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/a764cdc9-6bea-4600-a075-88a53c3d04aa/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/a764cdc9-6bea-4600-a075-88a53c3d04aa&q;}},&q;_name&q;:&q;Wood products in the bioeconomy&q;,&q;id&q;:&q;a764cdc9-6bea-4600-a075-88a53c3d04aa&q;,&q;uuid&q;:&q;a764cdc9-6bea-4600-a075-88a53c3d04aa&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;f90d847c-9a98-4727-8edd-5f42ebdcd3d2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Reck, B.K.; Johnston, C.; Foong, A.; Gupta, A.; Karpov, A.; Holsten, A.; Misselwitz, P.; Keenan, R.J.; Formenton Cardoso, N.; Walter, S.; Bull, L.; Steel, E.A.;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;e8bbb614-a25f-46a1-b94f-3ac11a4ffa52&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-25T07:50:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;1a47027d-fff3-4471-9e44-ba7cefe79dab&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-25T07:50:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;6a3d8876-9492-4784-ad80-6a227c5eaade&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;aab23a42-a8ae-4c25-8b3a-a31a47b29f9b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-06-25T07:46:12Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;d6f7b944-7fbd-4f22-8591-866fe3639109&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;A joint FAO and Bauhaus technical report examining how greater adoption of engineered wood products (EWPs) in construction could contribute to climate change mitigation. Using the FOROM global forest model, the report runs multiple scenarios out to 2070, testing different urbanization and wood-use assumptions, to project future EWP demand, estimate carbon storage and emissions substitution benefits, and benchmark results against national climate commitments (nationally determined contributions). Even under conservative assumptions, the findings point to EWPs as a credible and scalable climate strategy within a sustainably managed forest-based bioeconomy.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;b138c169-4afe-4ee4-a440-7434ebf14355&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;142 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;34dfebd5-a033-4178-ae9e-7b86bb17e14b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140786-8&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;9b675047-f8ad-4cf2-aa11-72c6720f730e&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0315en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;32ba83c3-676d-4665-99be-8dc4814af82a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;0ca35868-3c3b-49d3-96ba-968af5725e83&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;0b13edf2-bda8-40c1-a23a-b71956d44574&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;22261048-0ded-46e1-b2d3-a6782d5d2263&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title