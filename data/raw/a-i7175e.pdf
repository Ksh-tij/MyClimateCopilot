bb/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13df72e5-fa1e-46b7-b2e6-d532eed04fbb/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13df72e5-fa1e-46b7-b2e6-d532eed04fbb/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13df72e5-fa1e-46b7-b2e6-d532eed04fbb/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13df72e5-fa1e-46b7-b2e6-d532eed04fbb/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13df72e5-fa1e-46b7-b2e6-d532eed04fbb/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13df72e5-fa1e-46b7-b2e6-d532eed04fbb/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13df72e5-fa1e-46b7-b2e6-d532eed04fbb&q;}},&q;_name&q;:&q;The State of Agricultural Commodity Markets 2026&q;,&q;id&q;:&q;13df72e5-fa1e-46b7-b2e6-d532eed04fbb&q;,&q;uuid&q;:&q;13df72e5-fa1e-46b7-b2e6-d532eed04fbb&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;b98def8a-3209-458b-974d-834855adbf76&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;05a30775-48d2-4339-9658-479f3c431d34&q;,&q;language&q;:null,&q;value&q;:&q;2026-07-09T08:00:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;f111dc35-2ca6-44b4-87f9-a6f98bcff1aa&q;,&q;language&q;:null,&q;value&q;:&q;2026-07-09T08:00:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;929ce43b-ae51-4760-aecf-38cf33d6a3c0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;2841c4a6-576c-464f-b823-96ec31c2750f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-07-09T07:58:35Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;adc1eee3-e458-4fbf-8dce-38fbcf28f73c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Food and agricultural trade increased fivefold between 2000 and 2024, with low- and middle-income countries becoming more integrated into global markets. Yet these markets face growing exposure to shocks, including extreme weather, conflicts, pandemics, macroeconomic pressures and financial crises. The 2026 edition of The State of Agricultural Commodity Markets examines how such shocks affect trade, how disruptions are transmitted through trade linkages, and what this means for global food security. It highlights the need for trade policies that reflect the interdependence of agrifood systems, strengthen resilience and help mitigate the effects of shocks on food markets and food security.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;ceb0fa3a-19d8-4345-9de8-0777c39f07ba&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;103&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;07676840-7449-4a09-83e0-39c5ac1709d7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8215&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;2c5c9382-6962-4363-8cb9-7268a513ec9f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140464-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;5e86149a-ce9c-4723-8d78-03f49de2a8a9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8207&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;24d6befc-a6a1-4bc9-a277-8fa5c8ad7f14&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8309en&q;,&q;place