ef&q;:&q;https://openknowledge.fao.org/server/api/core/items/8beea7f6-8644-4ad4-8b16-723236afb857/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/8beea7f6-8644-4ad4-8b16-723236afb857/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/8beea7f6-8644-4ad4-8b16-723236afb857&q;}},&q;_name&q;:&q;The State of World Fisheries and Aquaculture 2026&q;,&q;id&q;:&q;8beea7f6-8644-4ad4-8b16-723236afb857&q;,&q;uuid&q;:&q;8beea7f6-8644-4ad4-8b16-723236afb857&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;ecba8a94-e25d-484c-be95-573c5f961aa9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;29bba66b-7bd8-4526-b0fb-9768f7a5d522&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;World&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;d05eee6b-4615-4d85-88e7-a07b5b445e49&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T15:21:08Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;947808a9-8ef6-4fe5-a84f-af392d41de1a&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T15:21:08Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;ade0274e-74b9-40aa-995e-5853c211939f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;fec77d58-cc77-494e-b60c-344357e7572b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-04T15:17:38Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;69a38ad9-492c-4ad2-a4d0-5e493b94e1b0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The State of World Fisheries and Aquaculture 2026 provides the latest evidence-based information and insights on challenges, opportunities and solutions shaping the present and future of the sector. This 2026 edition showcases how FAO is translating the Blue Transformation vision into impact, deploying field projects in close collaboration with Members, partners and key stakeholders. It highlights efforts to maximize the contribution of aquatic foods to global food security, poverty alleviation and economic development, enhancing policy advocacy, advancing scientific research and innovations, and furthering capacity development.Part 1 presents an up-to-date global review of fisheries and aquaculture production, employment, utilization and trade, benefiting from significant improvements in data collection and in analytical and assessment tools and methodologies. Part 2 explores the transformational actions being undertaken by FAO, its Members and key stakeholders to catalyse the changes required to support aquaculture expansion and intensification, effective management of global fisheries, and upgrading of aquatic value chains. Part 3 covers FAO commitments to strengthen aquatic food systems in a holistic manner, with a focus on the role of regional fishery bodies in translating international commitments into actionable regional measures; it emphasizes the importance of global climate research and models to inform adaptive fisheries management policies and decisions. It also presents an outlook on future trends for fisheries and aquaculture development up to 2034 based on projections.The State of World Fisheries and Aquaculture is aimed at a wide and expanding audience of policymakers, managers, researchers, private actors, civil society activists and consumers.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;848eef78-1fde-472e-bfdd-913d4c74f85d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;236 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eisbn&q;:[{&q;uuid&q;:&q;30aa996f-743b-4d1f-9d6a-ef166ae6ba09&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140733-2&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;754d4c75-0dba-46b7-8d77-7220dd5c3981&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2410-5902&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;8ae33c70-544d-4148-9783-597b0a068634&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140453-9&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;a316fe21-8d6e-474b-9def-6efae683bfb9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1020-5489&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;279231de-06c3-4db0-9cff-ddd74654691b&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8357en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;629c0be4-3528-448c-9cab-e97ed1f81017&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;eefbf78a-b55c-4baf-8985-7109028e8a0b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;a04796b5-7910-426c-a0c3-f0d4749ce940&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The State of World Fisheries and Aquaculture (SOFIA)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;14f5375b-51dd-451a-9862-fd06584de6b1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;3e61fc12-04d5-4d13-8f4c-a31255d4a372&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;cbc30f88-7651-4c51-bcf6-973f41dc8323&q;,&q;language&q;:&q;&q;,&q;value&q;:&q