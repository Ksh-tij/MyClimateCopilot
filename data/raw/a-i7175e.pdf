rg/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e&q;}},&q;_name&q;:&q;Principes généraux d’hygiène alimentaire&q;,&q;id&q;:&q;d64140cb-47c3-40fe-9bfe-74deb76a1a6e&q;,&q;uuid&q;:&q;d64140cb-47c3-40fe-9bfe-74deb76a1a6e&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;8d05683b-2a27-4c96-8de7-e37b2a9ad545&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; WHO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;6f8b306b-2341-45d7-9ec7-fb9842c7bd4d&q;,&q;language&q;:null,&q;value&q;:&q;2025-04-15T08:47:24Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;2e8f9afd-98db-4de2-b81e-80c0298b73ae&q;,&q;language&q;:null,&q;value&q;:&q;2025-04-15T08:47:24Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;c699066b-1e89-48f5-a33b-0d6fb2828fbf&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;424b2153-d286-463f-917c-ec3be8ef4e08&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-04-15T08:45:40Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;9c8eff55-2519-4cb9-af56-25651c579bea&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Le présent document énonce les principes généraux qui devraient être compris et respectés par les exploitants du secteur alimentaire au long de la chaîne alimentaire, et constitue une base pour les autorités compétentes chargées de superviser la sécurité sanitaire et la salubrité des aliments.Cette édition contient une nouvelle annexe qui introduit des outils permettant de déterminer les points critiques pour la maîtrise dans un système d’analyse des dangers et points critiques pour leur maîtrise (HACCP).Le terme «Codex Alimentarius» vient du latin et signifie «code alimentaire». Les normes du Codex sont des textes ayant trait à l’alimentation au niveau international, c&s;est-à-dire des normes, des codes d&s;usages, des codes d&s;usages en matière d’hygiène, des lignes directrices et d’autres recommandations, établis pour protéger la santé des consommateurs et garantir des pratiques loyales dans le commerce des denrées alimentaires. L&s;ensemble des normes alimentaires et des textes apparentés adoptés par la Commission du Codex Alimentarius est connu sous le nom de Codex Alimentarius.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;f51c624e-e144-4419-9037-dde4a543b6a2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;60 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;92140020-ea2b-464b-949a-322c7240ac6e&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cc6125fr&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;a210d834-797e-4994-a836-3bb5b4d1e40a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;French&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;65a23aa8-ca48-4fe5-bda6-090b0ad3d3af&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;55fe300f-4289-4088-b24b-ee691c427d50&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;f552784e-8c51-459a-b3fa-9e3c4875df81&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Principes généraux d’hygiène alimentaire&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.englishtranslation&q;:[{&q;uuid&q;:&q;0c5f93e5-679f-425b-8576-7e155e94527d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;General principles of food hygiene&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;88c96ea1-fd95-4f03-a934-ca2704f50e88&q;,&q;language&q;