alue&q;:&q;Graham, Alison (OSG)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.leadauthoringunit&q;:[{&q;uuid&q;:&q;91a2472d-a5e9-48dd-8ee3-ec16d14efc08&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;OSG - Office of Sustainable Development Goals&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.placeofpublication&q;:[{&q;uuid&q;:&q;fd948d9a-78fe-44ec-a391-675ac393ed4a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Rome, Italy ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.previewpage&q;:[{&q;uuid&q;:&q;26e8616e-f966-4e9a-9643-98af53ea57c9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;p&g;The following FAO SDG briefs are available for download:&l;/p&g;&l;ul&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg1.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 1: End poverty in all its forms everywhere&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg2.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 2: End hunger, achieve food security and improved nutrition and promote sustainable agriculture&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg3.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 3: Ensure healthy lives and promote well-being for all at all ages&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg4.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 4: Ensure inclusive and equitable quality education and promote lifelong learning opportunities for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg5.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 5: Achieve gender equality and empower all women and girls&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg6.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 6: Ensure availability and sustainable management of water and sanitation for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg7.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 7: Ensure access to affordable, reliable, sustainable and modern energy for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg8.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 8: Promote sustained, inclusive and sustainable economic growth, full and productive employment and decent work for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg9.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 9: Build resilient infrastructure, promote inclusive and sustainable industrialization and foster innovation&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg10.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 10: Reduce inequality within and among countries&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg11.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 11: Make cities and human settlements inclusive, safe, resilient and sustainable&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg12.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 12: Ensure sustainable consumption and production patterns&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg13.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 13: Take urgent action to combat climate change and its impacts&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg14.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 14: Conserve and sustainably use the oceans, seas and marine resources for sustainable development&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg15.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 15: Protect, restore and promote sustainable use of terrestrial ecosystems, sustainably manage forests, combat desertification, and halt and reverse land degradation and halt biodiversity loss&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg16.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 16: Promote