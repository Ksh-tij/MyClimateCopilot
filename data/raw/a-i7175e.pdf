ll,&q;value&q;:&q;2026-02-26T09:20:27Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;13580a07-0914-46a9-8cb4-5bee21e53a7c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;1ef84e13-babe-4681-810d-15fb125f39ba&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-02-26T09:15:07Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;a6445eef-718c-4e33-b731-54ed28a29931&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The Highlights of science and innovation in FAO’s Work report was developed to illustrate the breadth and depth of science and innovation in FAO’s efforts. The FAO Science and Innovation Strategy is a key tool to support the implementation of the FAO Strategic Framework 2022-31. The report presents examples of FAO&s;s work that reflect the Strategy’s broad scope, inclusive of all scientific disciplines and all types of innovation. The examples span FAO’s work -- from enhancing productivity to healthy diets and reducing food loss and waste, from strengthening agricultural extension and advisory services to harnessing better data and digital agriculture, from One Health to adapting to climate uncertainty, from prevention and early warning to scaling investments and development of global and regional platforms for sharing data, among others.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;b90f2092-efe0-410c-b5b8-29d8d4616d3f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;71 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;ff5da86d-6f67-423d-9313-9284ebc2a0a3&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8352en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;1ef964ef-a96c-4905-b050-98