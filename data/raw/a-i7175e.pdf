edge.fao.org/server/api/core/items/13d2a2f1-4910-4225-ac53-da5c20c29c18/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13d2a2f1-4910-4225-ac53-da5c20c29c18/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/13d2a2f1-4910-4225-ac53-da5c20c29c18&q;}},&q;_name&q;:&q;The status of women in agrifood systems in sub-Saharan Africa&q;,&q;id&q;:&q;13d2a2f1-4910-4225-ac53-da5c20c29c18&q;,&q;uuid&q;:&q;13d2a2f1-4910-4225-ac53-da5c20c29c18&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;50bf6807-3dcc-45e8-b4e6-69445c3ef064&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; NRI; AWARD;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;458bd425-13fe-47b5-b584-f7779a905dd1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Africa&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;98bdac9e-bcf2-481e-865c-8b0c2c92286f&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-11T11:50:47Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;e5d59e02-9a74-44a9-8f56-a6bcd674d368&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-11T11:50:47Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;55ffff61-4049-404c-b2af-9d6cf6fb33ba&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;5f401fc7-6efe-480c-a4dd-e8714d8f480c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-05-11T11:49:20Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;adb62671-26f9-4146-9dd7-b25373120fdd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The status of women in agrifood systems in sub-Saharan Africa provides the latest data, policy highlights and recommendations for policy- and decision-makers about gender in agrifood systems in sub-Saharan Africa. The report reviews and analyses women’s opportunities and constraints in economic and social processes in sub-Saharan Africa, while taking stock and assessing progress made in closing a series of gender gaps. It provides new directions, examples of policies and good practices that promote gender, climate and environmentally just agrifood systems in sub-Saharan Africa.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;5e43f29a-346f-4cab-9b5c-a7111207b5a9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;274 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;b102d2c2-cce7-45e9-9792-7fe4e6355dc0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140633-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;7c10ede0-303d-45f8-9007-3a7605319727&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9262en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;acafb0e3-f134-4cf4-bbd6-61c5935289e7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;864be7ed-045d-415c-bdef-be2dd156a62f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; African Women in Agricultural Research and Development (AWARD) ; Natural Resources Institute of University of Greenwich (NRI) ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;93c983cf-9b0a-40b0-acb7-1c41abd2eb5b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;d5c58e9e-67c6-473d-ae90-7bb17591ce9f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc