a0c8-05fc-488a-8be0-a20f9a44156c/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c455a0c8-05fc-488a-8be0-a20f9a44156c/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c455a0c8-05fc-488a-8be0-a20f9a44156c/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/c455a0c8-05fc-488a-8be0-a20f9a44156c&q;}},&q;_name&q;:&q;Informe sobre la cuenta atrás de los sistemas alimentarios 2026&q;,&q;id&q;:&q;c455a0c8-05fc-488a-8be0-a20f9a44156c&q;,&q;uuid&q;:&q;c455a0c8-05fc-488a-8be0-a20f9a44156c&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;26744abf-e068-4f60-8e82-9e95a15f76d1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;GAIN; FAO; Cornell Univ., Ithaca;  Johns Hopkins University School of Advanced International Studies;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;b673ae62-c824-48b7-bccb-c7851a10812c&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-10T07:55:16Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;aedc744c-3fe7-40fb-a5ff-2dbf870a7fca&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-10T07:55:16Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;4bdabf71-f051-4be5-a7bb-43ce27892d21&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;6db7d562-bd00-49ab-a1fa-bca00b64581d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-10T07:53:52Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;4f1dd38a-8148-4b37-81d0-2dd20468121b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Los sistemas alimentarios son fundamentales para la vida humana al sostener la alimentación, los medios de vida y los servicios ecosistémicos; tienen un potencial aún no aprovechado para contribuir positivamente al desarrollo sostenible. Sin embargo, en la actualidad también plantean retos para la salud humana, la equidad y la sostenibilidad medioambiental. Aunque se están realizando esfuerzos para transformar los sistemas alimentarios para que contribuyan mejor al logro de estos objetivos, se necesitan métricas bien definidas para superar lo anecdótico y realizar un seguimiento sistemático de los avances en todos los países. El tercer Informe sobre la cuenta atrás de los sistemas alimentarios, en su versión resumida, responde a esta necesidad complementando los datos previos sobre las tendencias de 50 indicadores de sistemas alimentarios cuidadosamente seleccionados con un análisis sobre si el progreso es suficiente para alcanzar los objetivos acordados para la transformación de los sistemas alimentarios, basándose en un conjunto exhaustivo de metas y puntos de referencia.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;6032baf5-e988-4386-b00c-34ed59f0ec76&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;3 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;909f91a6-e96f-4a93-8953-bdaafbf5cdbf&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0482es&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;fd138716-1b86-49f1-a151-a81e6406f084&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Spanish&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;9cd1704e-23d0-45f8-a839-18cd2e9db3a3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;GAIN ; FAO ; Cornell University ; Johns Hopkins University ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;402c4359-e454-4f61-bada-f10e7a94c4f2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Shared&q;,&q;place&q