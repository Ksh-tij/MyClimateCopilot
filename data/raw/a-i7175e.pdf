-17T06:49:22Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;a7e2973e-53a5-4326-a2ff-1250493544d2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Agriculture is a cornerstone of sub-Saharan Africa&s;s economy, yet it falls short of meeting regional food security and nutrition needs. Low productivity is widespread, particularly where soil quality and health have been degraded. Fertilizers can play a key role in breaking this cycle, but only where conditions support their effective use. This report by the FAO Investment Centre, in partnership with Agrinatura and the European Union, examines the structural, market and agronomic constraints to improving soil health and fertilizer use, and assesses the tools and options available to address them. It finds that raising yields will require increased mineral fertilizer use, complemented by proven agroecological and soil health management approaches. The evidence points away from uniform solutions and traditional approaches that have favoured fertilizer subsidies to limited effect, and shows that policies and programmes must be tailored to the agronomic realities and socioeconomic circumstances of different smallholder contexts. This report is part of the Directions in Investment series under the FAO Investment Centre&s;s Innovation and Knowledge for Investment (IK4I) programme.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;8aece468-e6e7-4cfe-ab10-793101db3cd4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;108 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;a10aa0c9-b55f-45b9-86f4-db6187d1dd20&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140746-2&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;b964dad7-006c-4d0b-9d7a-99f611f504c5&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9916en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;47930d61-2083-40a9-b8df-2e88f948ad6f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;7f3d2460-3e20-471b-b654-277398425167&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; AGRINATURA ; European Union ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;197c937d-477a-4efd-8953-2992ec37ebad&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Directions in Investment&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;bcdc7b70-049a-460f-941d-d2d5e9438226&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No. 19&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;8c286886-7c82-4ae6-a79d-c805b70f0e62&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Shared&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;69f38b87-80ec-4174-8c39-24080095b364&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;b43883a3-4bc8-488d-8d8d-ca8f56194379&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Soil health and fertilizer&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;b7dff402-1077-4b38-8a69-a7958eeba303&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Policy and investment prospects in sub-Saharan Africa&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;3f4a188a-5eb7-4ced-ae0b-8ec4ee802264&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (series)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;de63b1fb-5531-4f5d-879b-37c425dd3c8a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Yes&q;,&q;place&q;:0,&q;authority&q;:null,