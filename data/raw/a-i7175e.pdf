//openknowledge.fao.org/server/api/core/items/4d3f633b-30c2-4811-bb54-9ec4b9735d70/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4d3f633b-30c2-4811-bb54-9ec4b9735d70/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4d3f633b-30c2-4811-bb54-9ec4b9735d70/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4d3f633b-30c2-4811-bb54-9ec4b9735d70&q;}},&q;_name&q;:&q;Доклад обратный отсчет для продовольственных систем 2026&q;,&q;id&q;:&q;4d3f633b-30c2-4811-bb54-9ec4b9735d70&q;,&q;uuid&q;:&q;4d3f633b-30c2-4811-bb54-9ec4b9735d70&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;6431ac47-4835-4c2c-88ff-377ea712665f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;GAIN; ​ФАО; Cornell Univ., Ithaca;  Johns Hopkins University School of Advanced International Studies;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;0ed120eb-07b6-4269-bacd-9453b920b403&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-10T09:40:15Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;6f922e1f-1b4c-49bc-a590-99af47f77cea&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-10T09:40:15Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;0c2e4d74-c868-4cfe-8f50-306eb7196ffe&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;cf110fbb-d326-406f-9651-a9baf1516571&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-10T09:36:34Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;723c9c44-bd05-434d-ba28-db72b61e4415&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Продовольственные системы являются неотъемлемой частью жизни человека благодаря своей роли в обеспечении продовольствием, средствами к существованию и экосистемными услугами; они обладают нереализованным потенциалом для внесения положительного вклада в устойчивое развитие. Однако в настоящее время они также создают проблемы для здоровья человека, справедливости и экологической устойчивости. Хотя предпринимаются усилия по преобразованию продовольственных систем с целью более эффективной поддержки этих разнообразных целей, необходимы четко определенные показатели, чтобы не ограничиваться частными случаями и систематически отслеживать прогресс в разных странах. Третий доклад инициативы Обратный Отсчет Для Продовольственных Систем, краткое изложение которого приводится здесь,удовлетворяет эту потребность, дополняя предыдущие данные о тенденциях по 50 тщательно отобранным показателям продовольственных систем анализом того, достаточен ли прогресс для достижения согласованных целей трансформации продовольственных систем, основанных на всеобъемлющем наборе целевых показателей и контрольных ориентиров.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;c6638b6d-43c4-46a3-86a8-37accdca76fc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;3 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;9b8e9696-54ca-4256-b1a7-d56cc14d44a5&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0482ru&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;0b56fa78-a275-4763-873e-f5096ca49992&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Russian&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;cd337764-26ca-4b67-83a8-d9cf70c663f9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;GAIN ; ФАО ; Cornell University ; Johns Hopkins University ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;45af63b2-52bd-4ed9-8236-4fd191775