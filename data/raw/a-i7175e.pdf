pe&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;76fa1562-ff1c-4397-bed4-c9fc8b162b13&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;GAIN; FAO; Cornell Univ., Ithaca;  Johns Hopkins University School of Advanced International Studies;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;1b3daa92-9634-4db9-93f4-5c741aed8e63&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-10T07:45:15Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;1a0ebca6-31d3-458d-9704-fc435c7ae232&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-10T07:45:15Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;efe61a2a-0d02-45fe-80e3-ed924067f5d3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;37231480-16fa-4307-80e8-1d924079ba29&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-10T07:43:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;288c62cd-0d9a-4824-b411-1e6e5f16a49f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Food systems are integral to human life through their roles providing food, livelihoods, and ecosystem services; they have untapped capacity to positively contribute to sustainable development. Yet currently they also give rise to challenges for human health, equity, and environmental sustainability. While efforts to transform food systems to be more supporting of these diverse goals are underway, well-defined metrics are needed to move beyond anecdotes and systematically track progress across countries. The third report of the Food Systems Countdown Initiative, summarised here, meets this need by complementing prior data on trends in 50 carefully selected food system indicators with analysis of whether progress is good enough to achieve agreed upon goals of food system transformation, based on a comprehensive set of targets and benchmarks.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;59361171-1616-49ab-bea2-f5844e98825b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;3 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;de62d923-4175-498d-8495-3cd208cb4e04&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0482en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;66e986ba-da84-4af5-b9fc-a30fa985c433&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;cb03e4f4-582c-429a-9b9e-c74b3f111834&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;GAIN ; FAO ; Cornell University ; Johns Hopkins University ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;1a158ad2-d441-4ff9-aeeb-ba064b5eae7f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Shared&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;b6e141ed-49ff-4b2c-b1c7-399332c3be9f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;1d00e195-fb12-4be1-80ab-eaa4f9d913fa&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The food systems countdown report 2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;cae003ed-d52b-4407-a7d6-124427d5341c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Assessing performance, driving change – Summary&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;de86983e-fa0f-41a7-a2b3-d02d4727290d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Brochure, flyer, fact-sheet&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q