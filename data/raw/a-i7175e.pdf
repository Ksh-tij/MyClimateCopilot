ledge.fao.org/server/api/core/items/10b94a7b-ae5f-4fa4-8213-88fe91d7cac6/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10b94a7b-ae5f-4fa4-8213-88fe91d7cac6/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10b94a7b-ae5f-4fa4-8213-88fe91d7cac6/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10b94a7b-ae5f-4fa4-8213-88fe91d7cac6&q;}},&q;_name&q;:&q;Ethiopia: Mitigating the impacts of El Niño&q;,&q;id&q;:&q;10b94a7b-ae5f-4fa4-8213-88fe91d7cac6&q;,&q;uuid&q;:&q;10b94a7b-ae5f-4fa4-8213-88fe91d7cac6&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;dd3e2112-6e05-461f-830b-4dfb72cbd099&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;06312c55-a94d-45ab-9398-6b84e7fc0d7c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Ethiopia&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;0e1febe4-ac2d-4c46-9ffe-69a765d2fa31&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-10T07:30:14Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;fc10b015-440b-4c0b-9668-588a6e77f5fb&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-10T07:30:14Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;551a4786-bad3-462e-b763-aa3d9f5dd013&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;61689ebc-fada-423e-93ab-cf05e9f8be0c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-10T07:28:10Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;6f5a4511-256e-44b7-aba9-92ef62625cd3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Ethiopia continues to face recurrent climate-induced and conflict-related shocks that are eroding livelihoods, food security and household resilience. The forecast El Niño event is expected to further exacerbate vulnerabilities, with drought anticipated during kiremt season (June–September) and an increased risk of flooding between October and December. Timely support is critical to implement anticipatory actions to protect agricultural production, reduce the impact of climate extremes and strengthen the resilience of vulnerable agropastoral and pastoral households before conditions deteriorate further.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;9c12dc28-4af8-45d6-911d-bdfafea0d369&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;3 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;afcc1006-2ef7-402f-a236-2216c85afbd7&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0997en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;acaf8993-a151-487b-b810-fe6b29cd0383&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;bbce7c9e-bb86-42d5-bbaf-58cd284f1544&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;681571c6-e7a8-48f0-89e4-0470131b8f57&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;228ffd27-0e83-4cf3-a9e7-f4f8c7918222&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;a328e7e1-b195-4da3-b555-80cf6fb393ed&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Ethiopia: Mitigating the impacts of El Niño&q;,&q;place&q;:0,&q;authority&q;:null,&q;