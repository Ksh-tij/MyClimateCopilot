;,&q;lastModified&q;:&q;2026-06-18T08:54:26.230Z&q;,&q;isArchived&q;:true,&q;isDiscoverable&q;:true,&q;isWithdrawn&q;:false,&q;_links&q;:{&q;bundles&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9054dd1a-e9eb-456e-88f7-c6ab657f22ad/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9054dd1a-e9eb-456e-88f7-c6ab657f22ad/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9054dd1a-e9eb-456e-88f7-c6ab657f22ad/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9054dd1a-e9eb-456e-88f7-c6ab657f22ad/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9054dd1a-e9eb-456e-88f7-c6ab657f22ad/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9054dd1a-e9eb-456e-88f7-c6ab657f22ad/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9054dd1a-e9eb-456e-88f7-c6ab657f22ad/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9054dd1a-e9eb-456e-88f7-c6ab657f22ad/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9054dd1a-e9eb-456e-88f7-c6ab657f22ad&q;}},&q;_name&q;:&q;Food Outlook – Biannual report on global food markets&q;,&q;id&q;:&q;9054dd1a-e9eb-456e-88f7-c6ab657f22ad&q;,&q;uuid&q;:&q;9054dd1a-e9eb-456e-88f7-c6ab657f22ad&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;1e8b6cd4-a844-4bd7-a692-b313fef28df0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;178f8863-ae07-4ca6-acd0-8c3452bc1a94&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-18T08:45:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;0e9ea284-9f27-48bb-a904-03168a307a02&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-18T08:45:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;3ea6b91f-bf5b-47c4-ad17-8e711457dd4b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;780d1633-a589-4e53-9b08-2082b683b5b5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-06-18T08:39:42Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;e8bca8d7-3738-4b1c-ac67-5c7f33b050ec&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Despite spillovers from energy and fertilizer markets into agriculture, FAO’s latest assessments point to a still relatively favourable outlook for global food commodity markets. Cereal production is expected to ease from record highs but remain at historically elevated levels. Nevertheless, the outlook remains highly contingent on weather developments, including emergence of El Niño, which continue to pose significant risks to production. At the same time, rising conflicts and geopolitical tensions, uncertainty surrounding trade policies, as well as broader macroeconomic headwinds, weigh on trade prospects and market stability.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;e693fe28-36de-47b4-b8fc-b197079282b1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;137 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;8e9afd14-8e37-47da-b1d0-1e2c8d533a37&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1560-8182&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;eabf9fe4-2499-4841-911e-81f9818097a6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140448-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uui