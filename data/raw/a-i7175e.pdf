8530c89d/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/10293134-009e-416b-876b-84158530c89d&q;}},&q;_name&q;:&q;The status of land tenure and governance&q;,&q;id&q;:&q;10293134-009e-416b-876b-84158530c89d&q;,&q;uuid&q;:&q;10293134-009e-416b-876b-84158530c89d&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;0d689c0d-b851-477b-be8e-7153c6947124&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; ILC; CIRAD;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;bd3156c4-d38e-4133-bc93-efdca85d9446&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-25T08:30:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;79e45eb8-84de-4133-a20e-90dce4c5368e&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-25T08:30:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;603ab800-02c1-4657-a973-a0da53b3f259&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;b701e28b-c69e-458e-848c-40f4daa4907d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-02-25T08:27:13Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;80462054-74da-4319-b475-93e4b693226c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This report generates, presents and assesses innovative data, and extracts insights regarding land tenure systems and governance frameworks, with special focus on women&s;s land rights and the importance of customary tenure for mitigating climate change and ensuring the protection of biodiversity. Bringing together tenure- and sex- disaggregated data and analyses on land tenure and governance from a variety of sources (governments, civil society and academia) at different levels (from local to global), it builds an evidence base for action towards the achievement of numerous Sustainable Development Goals, the uptake of the Voluntary Guidelines on the Responsible Governance of Tenure of Land, Fisheries and Forests in the Context of National Food Security (VGGT), and other international frameworks (such as the Principles for Responsible Investment in Agriculture and Food Systems [CFS-RAI] and the Rio Conventions).The report also aims to provide policymakers, intergovernmental organizations, civil society, the private sector, and academia with a clear reference point on data and analyses on land tenure and governance. Moreover, it endeavours to mainstream and highlight the importance of land tenure for inclusive and sustainable development.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;68d9a76d-dcac-4a70-aff7-c738f2fced59&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;264 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;5cc346c6-5945-4963-ae30-719ec3a1e60c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140491-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;aa315603-106a-4ce3-8b81-4592dbaa6e7e&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8473en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;652cfb2b-e7