# Groq API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model selection (optional).
# Each model has its OWN daily token quota, so switching model is the fastest
# way around a 429 rate-limit error. Leave unset to use llama-3.3-70b-versatile.
#
#   llama-3.3-70b-versatile   best quality (default)
#   llama-3.1-8b-instant      fast and light, separate quota pool
#   openai/gpt-oss-20b        separate quota pool
#   openai/gpt-oss-120b       separate quota pool
#   qwen/qwen3.6-27b          separate quota pool
#
# GROQ_MODEL=llama-3.1-8b-instant

# Model used for self-evaluation. Falls back to GROQ_MODEL if unset.
# Pointing this at a different model spreads load across two quota pools.
# GROQ_EVAL_MODEL=llama-3.1-8b-instant
